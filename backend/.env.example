# Copia este archivo como .env (o define las variables en tu hosting).

# Puerto del servidor.
PORT=8080

# Base de datos PostgreSQL (Neon). Con esto los datos de las APIs se guardan en
# el esquema "tzinda" y se leen en tiempo real las lecturas de la pulsera física.
# Sin DATABASE_URL se usa el archivo JSON de DATA_FILE.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require
DATABASE_URL=
DB_SCHEMA=tzinda

# Pulsera física: tabla con sus lecturas (una fila por segundo).
SENSOR_ENABLED=true
SENSOR_TABLE=public.lecturas
SENSOR_POLL_MS=1000
# Nombre de la persona que usa la pulsera (aparece en los avisos).
SENSOR_PERSON_NAME=
# Segundos sin lecturas para mostrar la pulsera "sin conexión".
SENSOR_ONLINE_SECONDS=15
# Si la pulsera marca otra caída antes de este tiempo, no se repite el aviso.
SENSOR_ALERT_COOLDOWN_S=120

# URL pública para los links que llegan por SMS (sin "/" al final).
# Déjala vacía en la red local: se usa la dirección con la que llegó el teléfono.
PUBLIC_URL=

# Archivo donde se guardan los datos.
DATA_FILE=data/guardian.json

# Clave para crear comunidades (header X-Admin-Key). Si no la defines,
# el servidor genera una temporal y la muestra al arrancar.
ADMIN_KEY=

# Token de un bot de Telegram (créalo con @BotFather) para avisar a familiares.
TELEGRAM_BOT_TOKEN=

# Cada cuánto manda el teléfono su latido y cuándo se considera "sin reportarse".
HEARTBEAT_EVERY_MIN=15
OFFLINE_AFTER_MIN=45

# Batería a partir de la cual se avisa a la familia.
LOW_BATTERY_PERCENT=15

# Si nadie responde "Voy en camino", se vuelve a avisar cada N minutos, hasta M veces.
ESCALATE_AFTER_MIN=3
MAX_ESCALATIONS=3

# Vigencia de los códigos de vinculación y días que se guardan los datos.
INVITE_TTL_MIN=30
RETENTION_DAYS=30
